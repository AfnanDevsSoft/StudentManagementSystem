# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration - CHANGE IN PRODUCTION
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smsnow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DATABASE_URL="postgresql://postgres:CHANGE_THIS_IN_PRODUCTION@localhost:5432/smsnow"

# JWT Configuration - GENERATE SECURE SECRETS
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_256BIT_SECURE_SECRET_HERE
JWT_EXPIRY=3600
REFRESH_TOKEN_SECRET=GENERATE_256BIT_SECURE_SECRET_HERE
REFRESH_TOKEN_EXPIRY=604800

# Email Configuration
EMAIL_SERVICE=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# File Upload
MAX_FILE_SIZE=5242880  # 5MB in production
UPLOAD_DIR=./uploads

# Redis Cache
REDIS_URL=redis://localhost:6379
 
# CORS - Restrict in production
ALLOWED_ORIGINS=http://localhost:3000

# API Documentation
API_DOCS_PATH=/api/docs
